# PROD environment — set these as env vars in the hosting platform at build time
# (Vercel/Netlify/etc.), from the rideinsync-prod project. Do NOT commit real keys.
VITE_SUPABASE_URL=https://<prod-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<prod anon/public key>
VITE_GOOGLE_MAPS_API_KEY=<maps js key, restricted to the prod domain>
VITE_MAP_ID=<vector map id>
