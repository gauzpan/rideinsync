# Example secrets for Supabase Edge Functions (NEVER commit real keys).
# Set the real values with:  supabase secrets set KEY=value
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# into every Edge Function automatically — you do not set them here.

# --- push-notify (existing) -------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- send-sos-email (Gmail SMTP via nodemailer) -----------------------------
# A dedicated Gmail account used only for emergency-contact mail. If either
# secret is unset, send-sos-email logs and skips, so an SOS never fails just
# because email isn't configured.
#
# Requirements on the Gmail account:
#   * 2-Step Verification must be ON.
#   * Generate an App Password (Google Account -> Security -> App passwords) and
#     use it as GMAIL_APP_PASSWORD -- NOT the normal account password.
#   * Gmail SMTP is limited to ~500 mails/day on a free account; revisit a
#     transactional provider if that ceiling becomes a risk.
# From = GMAIL_USER.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
