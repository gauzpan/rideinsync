# Copy to .env.local and fill in. Never commit real keys.

# Supabase (real-time backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps (maps, traffic, weather)
VITE_GOOGLE_MAPS_API_KEY=

# Web Push (VAPID public key — generate with `npx web-push generate-vapid-keys`;
# the matching private key is a Supabase secret set via `supabase secrets set`,
# never a client env var — see supabase/functions/push-notify/index.ts header)
VITE_VAPID_PUBLIC_KEY=

