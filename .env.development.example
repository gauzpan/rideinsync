# DEV environment — copy to .env.local and fill from the rideinsync-dev project.
# .env.local is gitignored; never commit real keys.
VITE_SUPABASE_URL=https://<dev-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<dev anon/public key>
VITE_GOOGLE_MAPS_API_KEY=<maps js key>
VITE_MAP_ID=<vector map id>
VITE_PUBLIC_POSTHOG_KEY=<dev posthog project api key>
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
